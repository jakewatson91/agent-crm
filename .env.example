# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=https://inn.gs

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (embeddings only)
OPENAI_API_KEY=

# HubSpot benchmark baseline
HUBSPOT_PRIVATE_APP_TOKEN=

# Discovery sources (optional, free tier)
HUNTER_API_KEY=
PDL_API_KEY=
GITHUB_TOKEN=

# Dead-man's switch for the daily enrichment loop (scripts/run_loop.ts).
# Create a free check at healthchecks.io with period 24h + a few hours grace,
# paste its ping URL here. The loop pings it after each completed run; if the
# ping stops arriving, healthchecks emails you. Unset = no pings, no alarms.
HEALTHCHECKS_PING_URL=

# Email send (Resend). Drafts approved in the UI send via this.
# Per-workspace overrides live on workspaces.policy.outreach (resend_api_key,
# override_to, from_email, banned_phrases) — set those in Settings → Email.
# The env vars below are single-tenant fallbacks when a workspace doesn't
# override.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
