# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=https://inn.gs

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (embeddings only)
OPENAI_API_KEY=

# HubSpot benchmark baseline
HUBSPOT_PRIVATE_APP_TOKEN=

# Discovery sources (optional, free tier)
HUNTER_API_KEY=
PDL_API_KEY=
GITHUB_TOKEN=

# Dead-man's switches (healthchecks.io, free tier). Two SEPARATE checks:
#
# 1. Laptop backstop loop (scripts/run_loop.ts) pings this after each completed
#    run. Check period 24h + ~6h grace. Silence = the launchd backstop is dead.
#    Set in .env.local.
HEALTHCHECKS_PING_URL=
# 2. The health-sweep Inngest cron pings this after each completed run
#    (11:15/23:15 UTC). Check period 12h + ~6h grace. Silence = Render, Inngest,
#    or the DB is down. Set in the Render service env, NOT the same URL as #1.
HEALTHCHECKS_PING_URL_CLOUD=

# Email send (Resend). Drafts approved in the UI send via this.
# Per-workspace overrides live on workspaces.policy.outreach (resend_api_key,
# override_to, from_email, banned_phrases) — set those in Settings → Email.
# The env vars below are single-tenant fallbacks when a workspace doesn't
# override.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
