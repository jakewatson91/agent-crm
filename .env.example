# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=https://inn.gs

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (embeddings only)
OPENAI_API_KEY=

# HubSpot benchmark baseline
HUBSPOT_PRIVATE_APP_TOKEN=

# Discovery sources (optional, free tier)
HUNTER_API_KEY=
PDL_API_KEY=
GITHUB_TOKEN=

# Email send (Resend). Drafts approved in the UI send via this.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Safety override while dog-fooding: every approved send is rerouted here
# regardless of the agent's resolved recipient. Set to empty string to disable
# the override and send to the real recipient.
OUTREACH_OVERRIDE_TO=jaws.watson@gmail.com
